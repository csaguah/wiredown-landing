---
import ConsentBanner from '../components/ConsentBanner.astro';
import SEOHead from '../components/SEOHead.astro';
import HomeBlog from '../components/HomeBlog.astro';
import { getBlog } from '../lib/blog';

// Enlace al blog en el pie: solo si este build genera /blog/ (hay artículos publicados).
const { posts } = await getBlog();
const hasBlog = posts.length > 0;
// Sección «Del blog»: los 3 publicados más recientes (posts ya viene ordenado del más nuevo al más antiguo).
const latestPosts = posts.slice(0, 3);

// JSON-LD de la página de la guía. Solo datos visibles en la página: sin valoraciones ni reseñas.
// La guía es ["Product", "Book"]: Product aporta brand, category y offers; Book aporta author
// (Product no tiene author en schema.org). El autor es Person (nunca Physician), dentro de la
// guía y no como entidad principal; su nombre es el de la firma de «Palabras del autor».
const SITE = 'https://wire-down.com';
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': `${SITE}/#organization`,
      name: 'Wire Down',
      url: `${SITE}/`,
      logo: `${SITE}/apple-touch-icon.png`,
      email: 'soporte@wire-down.com',
    },
    {
      '@type': 'WebSite',
      '@id': `${SITE}/#website`,
      name: 'Wire Down',
      url: `${SITE}/`,
      inLanguage: 'es',
      publisher: { '@id': `${SITE}/#organization` },
    },
    {
      '@type': ['Product', 'Book'],
      '@id': `${SITE}/#guia`,
      name: 'Wire Down · Guía práctica de regulación',
      description: 'Una guía para personas que viven con dolor o tensión persistente y quieren entender qué papel juega el estrés, y qué pueden hacer cada día para ayudar a su cuerpo a regularse. Incluye la Bitácora Wire Down y un test orientativo.',
      url: `${SITE}/`,
      image: `${SITE}/og/wire-down-og.png`,
      category: 'Ebook',
      brand: { '@type': 'Brand', name: 'Wire Down' },
      bookFormat: 'https://schema.org/EBook',
      inLanguage: 'es',
      publisher: { '@id': `${SITE}/#organization` },
      author: {
        '@type': 'Person',
        name: 'Carlos Sagua H.',
        jobTitle: 'Kinesiólogo y quiropráctico',
      },
      offers: {
        '@type': 'Offer',
        price: '17.00',
        priceCurrency: 'USD',
        url: 'https://pay.hotmart.com/K105460326C?checkoutMode=2',
        availability: 'https://schema.org/InStock',
      },
    },
  ],
};
---
<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<!-- GTM con Consent Mode v2 (todo denegado por defecto). Va antes de cualquier otro script de medición. -->
<script is:inline src="/assets/wd-gtm.js"></script>
<!-- Atribución de ventas: sck, UTM y click ID en los enlaces de checkout (ver el archivo). Sin defer, después de wd-gtm.js. -->
<script is:inline src="/assets/wd-attribution.js"></script>
<!-- Eventos al dataLayer (solo con consentimiento de Analítica y con GTM ya cargado). -->
<script is:inline src="/assets/wd-events.js" defer></script>
<SEOHead
  title="Dolor y tensión asociados al estrés: guía práctica | Wire Down"
  description="Herramientas simples para regular tu sistema nervioso cuando el estrés se instala en el cuerpo como dolor o tensión. Ebook, Bitácora y test orientativo."
  path="/"
  jsonLd={jsonLd}
/>
<link rel="icon" href="/favicon.ico" sizes="32x32">
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<link rel="apple-touch-icon" href="/apple-touch-icon.png">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,400;0,600;0,700;1,400;1,600&family=DM+Sans:wght@300;400;500;600&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/assets/wd-tokens.css">
<link rel="stylesheet" href="/assets/wd-base.css">
<link rel="stylesheet" href="/assets/wd-consent.css">
<style is:inline>
/* Variables de marca: /assets/wd-tokens.css · Reset: /assets/wd-base.css */
html { scroll-behavior: smooth; }
body { font-family: 'DM Sans', sans-serif; color: var(--osc); background: #fff; line-height: 1.6; }
img { max-width: 100%; display: block; }
a { color: inherit; text-decoration: none; }

/* ─── TYPOGRAPHY ────────────────────────────────────────── */
h1,h2,h3,h4 { font-family: 'Lora', serif; line-height: 1.2; }
.serif { font-family: 'Lora', serif; }

/* ─── LAYOUT ────────────────────────────────────────────── */
.container { max-width: 780px; margin: 0 auto; padding: 0 24px; }
.container-wide { max-width: 960px; margin: 0 auto; padding: 0 24px; }

/* ─── HEADER BAR ────────────────────────────────────────── */
.topbar {
  background: var(--verde);
  color: #fff;
  text-align: center;
  padding: 10px 20px;
  font-size: 13px;
  font-weight: 500;
  letter-spacing: 0.3px;
}
.topbar span { color: var(--dorado); font-weight: 600; }

/* ─── HERO ──────────────────────────────────────────────── */
.hero {
  background: var(--sage);
  padding: 70px 24px 60px;
  text-align: center;
  position: relative;
  overflow: hidden;
}
.hero::before {
  content: '';
  position: absolute;
  bottom: -40px; left: 50%;
  transform: translateX(-50%);
  width: 600px; height: 600px;
  border-radius: 50%;
  background: rgba(45,90,61,0.04);
  pointer-events: none;
}
.hero-eyebrow {
  font-size: 11px;
  letter-spacing: 2.5px;
  text-transform: uppercase;
  color: var(--verde-m);
  font-weight: 600;
  margin-bottom: 20px;
}
.hero h1 {
  font-size: clamp(32px, 5vw, 52px);
  color: var(--verde);
  margin-bottom: 12px;
  max-width: 640px;
  margin-left: auto; margin-right: auto;
}
.hero-sub {
  font-family: 'Lora', serif;
  font-style: italic;
  font-size: clamp(16px, 2.5vw, 20px);
  color: var(--gris);
  margin-bottom: 32px;
  max-width: 520px;
  margin-left: auto; margin-right: auto;
}
.hero-price-wrap {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16px;
  margin-bottom: 28px;
  flex-wrap: wrap;
}
.price-old {
  font-size: 18px;
  text-decoration: line-through;
  color: var(--gris);
  opacity: 0.7;
}
.price-new {
  font-family: 'Lora', serif;
  font-size: 42px;
  font-weight: 700;
  color: var(--verde);
  line-height: 1;
}
.price-currency { font-size: 22px; vertical-align: super; }
.price-tag {
  background: var(--dorado);
  color: #fff;
  font-size: 12px;
  font-weight: 600;
  padding: 4px 12px;
  border-radius: 20px;
  letter-spacing: 0.5px;
  text-transform: uppercase;
}
.btn-primary {
  display: inline-block;
  background: var(--verde);
  color: #fff;
  font-family: 'DM Sans', sans-serif;
  font-size: 16px;
  font-weight: 600;
  padding: 18px 40px;
  border-radius: 50px;
  letter-spacing: 0.3px;
  transition: background 0.2s, transform 0.15s;
  cursor: pointer;
  border: none;
  text-align: center;
}
.btn-primary:hover { background: #1e4029; transform: translateY(-2px); }
.btn-secondary {
  display: inline-block;
  background: transparent;
  color: var(--verde);
  font-size: 14px;
  font-weight: 500;
  padding: 12px 28px;
  border-radius: 50px;
  border: 1.5px solid var(--verde);
  transition: all 0.2s;
  cursor: pointer;
}
.btn-secondary:hover { background: var(--sage); }
.hero-guarantee {
  margin-top: 16px;
  font-size: 12px;
  color: var(--gris);
}
.hero-guarantee span { color: var(--verde-m); font-weight: 600; }
.hero-test-link { margin-top: 10px; font-size: 13px; color: var(--gris); }
.hero-test-link a { color: var(--verde-m); text-decoration: underline; text-underline-offset: 3px; }

/* ─── PAIN SECTION ──────────────────────────────────────── */
.pain {
  background: #fff;
  padding: 70px 24px;
}
.pain h2 {
  font-size: clamp(24px, 3.5vw, 34px);
  color: var(--verde);
  text-align: center;
  margin-bottom: 12px;
}
.pain-intro {
  text-align: center;
  color: var(--gris);
  font-size: 15px;
  margin-bottom: 44px;
  max-width: 540px;
  margin-left: auto; margin-right: auto;
}
.pain-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
  gap: 16px;
}
.pain-card {
  background: var(--sage);
  border-radius: 14px;
  padding: 22px 20px;
  font-size: 14px;
  color: var(--osc);
  line-height: 1.55;
}
.pain-card .icon { font-size: 22px; margin-bottom: 10px; }
.pain-card strong { display: block; font-weight: 600; color: var(--verde); margin-bottom: 4px; font-family: 'Lora', serif; font-size: 15px; }

/* ─── QUOTE ─────────────────────────────────────────────── */
.quote-section {
  background: var(--verde);
  padding: 60px 24px;
  text-align: center;
}
.quote-text {
  font-family: 'Lora', serif;
  font-style: italic;
  font-size: clamp(18px, 2.8vw, 26px);
  color: #fff;
  max-width: 600px;
  margin: 0 auto 16px;
  line-height: 1.5;
}
.quote-sub {
  font-size: 13px;
  color: rgba(255,255,255,0.65);
  letter-spacing: 0.5px;
}

/* ─── PRODUCT ───────────────────────────────────────────── */
.product {
  background: var(--beige);
  padding: 70px 24px;
}
.product h2 {
  font-size: clamp(24px, 3.5vw, 34px);
  color: var(--verde);
  text-align: center;
  margin-bottom: 8px;
}
.product-intro {
  text-align: center;
  color: var(--gris);
  font-size: 15px;
  margin-bottom: 48px;
}
.modules-list {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
  gap: 14px;
  margin-bottom: 48px;
}
.module-item {
  display: flex;
  align-items: flex-start;
  gap: 14px;
  background: #fff;
  border-radius: 12px;
  padding: 18px 18px;
  border: 1px solid var(--sage-d);
}
.module-num {
  width: 32px; height: 32px;
  border-radius: 8px;
  background: var(--verde-xl);
  color: var(--verde);
  font-size: 13px; font-weight: 700;
  display: flex; align-items: center; justify-content: center;
  flex-shrink: 0;
  font-family: 'Lora', serif;
}
.module-num.sos { background: #FDEAEA; color: var(--rojo); }
.module-title { font-size: 13px; font-weight: 600; color: var(--osc); margin-bottom: 2px; }
.module-desc { font-size: 12px; color: var(--gris); line-height: 1.5; }

/* ─── BONOS ─────────────────────────────────────────────── */
.bonos {
  background: #fff;
  padding: 70px 24px;
}
.bonos h2 {
  font-size: clamp(24px, 3.5vw, 34px);
  color: var(--verde);
  text-align: center;
  margin-bottom: 8px;
}
.bonos-intro {
  text-align: center;
  color: var(--gris);
  font-size: 15px;
  margin-bottom: 48px;
}
.bonos-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
  gap: 24px;
}
.bono-card {
  border: 1.5px solid var(--sage-d);
  border-radius: 18px;
  overflow: hidden;
}
.bono-header {
  background: var(--sage);
  padding: 28px 28px 22px;
  position: relative;
}
.bono-tag {
  display: inline-block;
  background: var(--dorado);
  color: #fff;
  font-size: 10px;
  font-weight: 700;
  padding: 3px 10px;
  border-radius: 20px;
  letter-spacing: 0.8px;
  text-transform: uppercase;
  margin-bottom: 10px;
}
.bono-title {
  font-family: 'Lora', serif;
  font-size: 20px;
  color: var(--verde);
  line-height: 1.3;
  margin-bottom: 6px;
}
.bono-subtitle {
  font-style: italic;
  font-family: 'Lora', serif;
  font-size: 13px;
  color: var(--gris);
}
.bono-valor {
  position: absolute;
  top: 20px; right: 20px;
  font-size: 12px;
  color: var(--gris);
  text-align: right;
}
.bono-valor .v { font-family: 'Lora', serif; font-size: 18px; font-weight: 700; color: var(--verde); display: block; }
.bono-body { padding: 22px 28px; }
.bono-items { list-style: none; }
.bono-items li {
  font-size: 13px;
  color: var(--osc);
  padding: 6px 0;
  border-bottom: 1px solid var(--sage);
  display: flex;
  align-items: flex-start;
  gap: 8px;
  line-height: 1.5;
}
.bono-items li:last-child { border-bottom: none; }
.bono-items li::before { content: "✓"; color: var(--verde-m); font-weight: 700; flex-shrink: 0; }

/* ─── AUTHOR ────────────────────────────────────────────── */
.author {
  background: var(--sage);
  padding: 70px 24px;
}
.author-inner {
  display: flex;
  align-items: flex-start;
  gap: 36px;
  max-width: 680px;
  margin: 0 auto;
}
.author-avatar {
  width: 90px; height: 90px;
  border-radius: 50%;
  background: var(--verde);
  display: flex; align-items: center; justify-content: center;
  font-family: 'Lora', serif;
  font-size: 28px; font-weight: 700;
  color: #fff; flex-shrink: 0;
}
.author-name {
  font-family: 'Lora', serif;
  font-size: 22px;
  color: var(--verde);
  margin-bottom: 4px;
}
.author-role {
  font-size: 12px;
  color: var(--gris);
  margin-bottom: 14px;
  letter-spacing: 0.3px;
}
.author-bio {
  font-size: 14px;
  color: var(--osc);
  line-height: 1.7;
}
.author-sign { margin: 16px 0 0; }
@media (max-width: 520px) {
  .author-inner { flex-direction: column; align-items: center; text-align: center; }
}

/* ─── TESTIMONIALS ──────────────────────────────────────── */
.testimonials {
  background: #fff;
  padding: 70px 24px;
}
.testimonials h2 {
  font-size: clamp(22px, 3vw, 30px);
  color: var(--verde);
  text-align: center;
  margin-bottom: 40px;
}
.testi-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  gap: 20px;
}
.testi-card {
  background: var(--beige);
  border-radius: 14px;
  padding: 24px 22px;
}
.testi-stars { color: var(--dorado); font-size: 14px; margin-bottom: 10px; }
.testi-text {
  font-family: 'Lora', serif;
  font-style: italic;
  font-size: 13.5px;
  color: var(--osc);
  line-height: 1.65;
  margin-bottom: 14px;
}
.testi-name { font-size: 12px; font-weight: 600; color: var(--verde); }
.testi-role { font-size: 11px; color: var(--gris); }

/* ─── CTA FINAL ─────────────────────────────────────────── */
.cta-final {
  background: var(--verde);
  padding: 80px 24px;
  text-align: center;
}
.cta-final h2 {
  font-size: clamp(26px, 4vw, 40px);
  color: #fff;
  margin-bottom: 12px;
  max-width: 560px;
  margin-left: auto; margin-right: auto;
}
.cta-final-sub {
  font-family: 'Lora', serif;
  font-style: italic;
  font-size: 16px;
  color: rgba(255,255,255,0.75);
  margin-bottom: 36px;
  max-width: 460px;
  margin-left: auto; margin-right: auto;
}
.cta-includes {
  display: flex;
  justify-content: center;
  flex-wrap: wrap;
  gap: 12px;
  margin-bottom: 36px;
}
.cta-include-item {
  background: rgba(255,255,255,0.12);
  border: 1px solid rgba(255,255,255,0.2);
  border-radius: 50px;
  padding: 7px 18px;
  font-size: 13px;
  color: #fff;
  display: flex;
  align-items: center;
  gap: 6px;
}
.cta-include-item::before { content: "✓"; color: var(--verde-l); font-weight: 700; }
.btn-cta-final {
  display: inline-block;
  background: var(--dorado);
  color: #fff;
  font-family: 'DM Sans', sans-serif;
  font-size: 17px;
  font-weight: 700;
  padding: 20px 48px;
  border-radius: 50px;
  letter-spacing: 0.3px;
  transition: all 0.2s;
  cursor: pointer;
  border: none;
}
.btn-cta-final:hover { background: #b5943e; transform: translateY(-2px); }
.cta-price-note {
  margin-top: 18px;
  font-size: 13px;
  color: rgba(255,255,255,0.6);
}
.cta-price-note strong { color: #fff; }

.test-link { text-align: center; color: var(--gris); font-size: 15px; margin-top: 40px; }
.test-link p { margin-bottom: 12px; }

/* ─── FAQ ────────────────────────────────────────────────── */
.faq {
  background: var(--beige);
  padding: 70px 24px;
}
.faq h2 {
  font-size: clamp(22px, 3vw, 30px);
  color: var(--verde);
  text-align: center;
  margin-bottom: 40px;
}
.faq-item {
  border-bottom: 1px solid var(--sage-d);
  padding: 18px 0;
}
.faq-q {
  font-weight: 600;
  font-size: 15px;
  color: var(--osc);
  cursor: pointer;
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 12px;
}
.faq-q::after { content: "+"; color: var(--verde); font-size: 22px; flex-shrink: 0; }
.faq-q.open::after { content: "–"; }
.faq-a {
  display: none;
  font-size: 14px;
  color: var(--gris);
  line-height: 1.7;
  padding-top: 12px;
}
.faq-a.open { display: block; }

/* ─── DEL BLOG (HomeBlog.astro) ─────────────────────────────
   Tarjeta con el mismo estilo que PostList del blog. Una columna en móvil; hasta 3 en escritorio. */
.home-blog {
  background: var(--sage);
  padding: 70px 24px;
}
.home-blog h2 {
  font-size: clamp(22px, 3vw, 30px);
  color: var(--verde);
  text-align: center;
  margin-bottom: 36px;
}
.hb-list { list-style: none; display: grid; gap: 20px; grid-template-columns: 1fr; }
@media (min-width: 760px) {
  /* 3 × 288 px + 2 × 20 px = 904 px: caben en los 912 px útiles de .container-wide */
  .hb-list { grid-template-columns: repeat(auto-fit, minmax(240px, 288px)); justify-content: center; }
}
.hb-card { display: flex; flex-direction: column; height: 100%; background: #fff; border: 1.5px solid var(--sage-d); border-radius: 18px; overflow: hidden; text-decoration: none; color: inherit; transition: transform .15s; }
.hb-card:hover { transform: translateY(-2px); }
.hb-card img { width: 100%; height: auto; aspect-ratio: 1200 / 630; object-fit: cover; display: block; }
.hb-body { display: block; padding: 18px 20px 20px; }
.hb-cat { display: block; font-size: 12px; letter-spacing: 2px; text-transform: uppercase; color: var(--verde-m); font-weight: 600; margin-bottom: 6px; }
.hb-title { display: block; font-family: 'Lora', serif; font-size: 19px; line-height: 1.3; color: var(--verde); margin-bottom: 8px; }
.hb-desc { display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 3; overflow: hidden; font-size: 14px; color: var(--gris); line-height: 1.6; }
.hb-all { text-align: center; margin-top: 32px; }

/* ─── LEADS FORM ─────────────────────────────────────────── */
.leads-section {
  background: var(--sage);
  padding: 60px 24px;
  text-align: center;
}
.leads-section h3 {
  font-size: 22px;
  color: var(--verde);
  margin-bottom: 8px;
}
.leads-section p {
  font-size: 14px;
  color: var(--gris);
  margin-bottom: 24px;
}
.leads-form {
  display: flex;
  gap: 10px;
  max-width: 460px;
  margin: 0 auto;
  flex-wrap: wrap;
  justify-content: center;
}
.leads-form input {
  flex: 1;
  min-width: 200px;
  padding: 13px 18px;
  border: 1.5px solid var(--sage-d);
  border-radius: 50px;
  font-size: 14px;
  font-family: 'DM Sans', sans-serif;
  background: #fff;
  color: var(--osc);
  outline: none;
  transition: border-color 0.2s;
}
.leads-form input:focus { border-color: var(--verde); }
.leads-form button {
  background: var(--verde);
  color: #fff;
  border: none;
  padding: 13px 24px;
  border-radius: 50px;
  font-size: 14px;
  font-weight: 600;
  cursor: pointer;
  transition: background 0.2s;
  font-family: 'DM Sans', sans-serif;
}
.leads-form button:hover { background: #1e4029; }
.leads-note { font-size: 11px; color: var(--gris); margin-top: 10px; }
.leads-success {
  display: none;
  background: var(--verde-xl);
  border: 1px solid var(--verde-l);
  border-radius: 12px;
  padding: 16px 24px;
  font-size: 14px;
  color: var(--verde);
  font-weight: 500;
  max-width: 460px;
  margin: 0 auto;
}

/* ─── FOOTER ─────────────────────────────────────────────── */
footer {
  background: var(--osc);
  color: rgba(255,255,255,0.5);
  text-align: center;
  padding: 28px 24px;
  font-size: 12px;
  line-height: 1.8;
}
footer strong { color: rgba(255,255,255,0.8); }

/* ─── STICKY CTA (mobile) ───────────────────────────────── */
.sticky-cta {
  display: none;
  position: fixed;
  bottom: 0; left: 0; right: 0;
  background: var(--verde);
  padding: 14px 20px;
  z-index: 100;
  text-align: center;
  box-shadow: 0 -4px 20px rgba(0,0,0,0.15);
}
.sticky-cta a {
